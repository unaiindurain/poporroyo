# Twitch Developer Console (https://dev.twitch.tv/console/apps) — ver SETUP.md
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Cadena propia (no la da Twitch), usada para verificar la firma de EventSub.
# Genérala con: openssl rand -hex 32
TWITCH_EVENTSUB_SECRET=

# Firma las cookies de sesión. Genérala con: openssl rand -base64 48
SESSION_SECRET=

# Cifra en reposo los tokens del streamer. Debe decodificar a 32 bytes.
# Genérala con: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# URL pública del sitio ya desplegado (sin barra final). EventSub exige HTTPS público.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# La provisiona Neon/Vercel Postgres automáticamente al crear la integración.
DATABASE_URL=
